# Local dev default — matches docker-compose.yml. Point at Neon (or similar) in production.
DATABASE_URL="postgresql://waypoint:waypoint@localhost:5432/waypoint"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Shared default Claude key, used for every user until they add their own (§5.8). Server-side only.
ANTHROPIC_API_KEY=""

# AES-256-GCM key used to encrypt user-supplied provider API keys at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Vercel Blob (resumes, generated documents) — production. Not used in local dev.
BLOB_READ_WRITE_TOKEN=""

# Local S3-compatible blob storage (MinIO via docker-compose) — resumes for now (Milestone 3),
# per-application documents from Milestone 5 on. Console at http://localhost:9001
# (user/pass: jota / jota-dev-secret), bucket "jota-documents" auto-created.
BLOB_STORAGE_ENDPOINT="http://localhost:9000"
BLOB_STORAGE_ACCESS_KEY="jota"
BLOB_STORAGE_SECRET_KEY="jota-dev-secret"
BLOB_STORAGE_BUCKET="jota-documents"

# Authenticates the Vercel Cron call into /api/aggregate — Milestone 9+
CRON_SECRET=""

# Transactional email for password reset — Milestone 1's reset-password flow
RESEND_API_KEY=""

# DOCX -> PDF conversion service — Milestone 8
DOC_CONVERT_URL=""
