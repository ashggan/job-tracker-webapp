# Local dev default — matches docker-compose.yml. Point at Neon (or similar) in production.
DATABASE_URL="postgresql://waypoint:waypoint@localhost:5432/waypoint"

# NextAuth
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# AES-256-GCM key used to encrypt user-supplied provider API keys at rest. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=""

# Vercel Blob (resumes, generated documents) — Milestone 5+.
# Local dev: MinIO via docker-compose (S3-compatible), console at http://localhost:9001
# (user/pass: waypoint / waypoint-dev-secret), bucket "waypoint-documents" auto-created.
BLOB_READ_WRITE_TOKEN=""

# Authenticates the Vercel Cron call into /api/aggregate — Milestone 9+
CRON_SECRET=""

# Transactional email for password reset — Milestone 1's reset-password flow
RESEND_API_KEY=""

# DOCX -> PDF conversion service — Milestone 8
DOC_CONVERT_URL=""
