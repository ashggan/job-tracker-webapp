generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())

  profile       UserProfile?
  apiKeys       UserApiKey[]
  applications  Application[]
  aiUsageLogs   AIUsageLog[]
  resetTokens   PasswordResetToken[]
  resume        UserResume?
  wizardDraft   WizardDraft?
}

// Supports the in-app "forgot password" flow (§4). Not one of the spec's
// core business entities — pure auth infrastructure.
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ---------- Profile & preferences (§5.1) ----------

model UserProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resumeFileUrl    String?
  resumeStructured Json?
  preferencesText  String?  @db.Text
  updatedAt        DateTime @updatedAt
}

// ---------- AI provider & keys (§5.8) ----------

enum LlmProvider {
  anthropic
  openai
  google
  other
}

model UserApiKey {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     LlmProvider
  encryptedKey String      @db.Text
  keyPreview   String
  isActive     Boolean     @default(false)
  createdAt    DateTime    @default(now())

  @@index([userId])
}

// ---------- Job aggregation (§5.2) ----------

enum JobSourceType {
  api
  scrape
}

model JobSource {
  id         String        @id @default(cuid())
  name       String        @unique
  type       JobSourceType
  config     Json
  enabled    Boolean       @default(true)
  lastRunAt  DateTime?

  rawListings RawListing[]
}

model RawListing {
  id              String    @id @default(cuid())
  sourceId        String
  source          JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  externalId      String
  title           String
  company         String
  location        String?
  url             String
  descriptionText String    @db.Text
  postedAt        DateTime?
  fetchedAt       DateTime  @default(now())

  applications Application[]

  @@unique([sourceId, externalId])
  @@index([url])
}

// ---------- Applications: the core record (§5.5, §5.7) ----------

enum Stage {
  wishlist
  applied
  under_review
  interview
  offer
  rejected
  withdrawn
}

enum FitLabel {
  stretch
  fair
  good
  strong
}

model Application {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle       String
  company        String
  postingUrl     String?
  location       String?
  source         String   // aggregated board name, or "manual"
  descriptionText String? @db.Text // full posting text, from guided-add extraction
  requirements   Json?    // string[] — required quals, as extracted
  niceToHaves    Json?    // string[]
  keywords       Json?    // string[] — ATS-style terms the posting emphasizes
  deadline       DateTime? // null if the posting didn't state one

  rawListingId String?
  rawListing   RawListing? @relation(fields: [rawListingId], references: [id], onDelete: SetNull)

  stage       Stage    @default(wishlist)
  dateFound   DateTime @default(now())
  dateApplied DateTime?

  fitScore          Int?
  fitLabel          FitLabel?
  fitStrengths      Json?     // string[] — specific, tied to requirement items
  fitGaps           Json?     // string[]
  fitRecommendation String?   @db.Text // plain-language line, e.g. "7/10 — worth tailoring"
  fitGeneratedAt    DateTime?

  interviewPrepNotes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes              Note[]
  documents          Document[]
  tailoredDocuments  TailoredDocument[]
  stageEvents        StageEvent[]

  @@index([userId, stage])
  @@index([userId, postingUrl])
}

model Note {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  body          String      @db.Text
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

enum DocumentKind {
  cv
  cover_letter
  other
}

model Document {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          DocumentKind
  filename      String
  storageUrl    String
  uploadedAt    DateTime     @default(now())

  @@index([applicationId])
}

enum TailoredKind {
  cv
  cover_letter
  prep_notes
  perks
  application_email
}

model TailoredDocument {
  id            String       @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  kind          TailoredKind
  version       Int
  contentJson   Json
  docxUrl       String?
  createdAt     DateTime     @default(now())

  @@index([applicationId, kind])
}

model StageEvent {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStage     Stage?
  toStage       Stage
  changedAt     DateTime    @default(now())

  @@index([applicationId])
}

// ---------- AI usage accounting (§5.8, §5.10) ----------

enum AIAction {
  score
  tailor_cv
  tailor_cover_letter
  extract_listing
  extract_resume
  generate_prep_notes
  generate_perks_summary
  import_applications
  generate_application_email
}

model AIUsageLog {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  action       AIAction
  provider     LlmProvider
  tokensUsed   Int         @default(0)
  costEstimate Float
  createdAt    DateTime    @default(now())

  @@index([userId, createdAt])
}

// ---------- Resume (§5.10) ----------

enum ResumeFileType {
  PDF
  DOCX
}

enum ResumeParseStatus {
  OK
  LOW_CONFIDENCE
  FAILED
}

model UserResume {
  id               String            @id @default(cuid())
  userId           String            @unique
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalFilename String
  fileType         ResumeFileType
  fileBytes        Bytes
  fileSizeBytes    Int
  extractedText    String            @db.Text
  parseStatus      ResumeParseStatus
  parseWarning     String?

  // Derived, read-only cache of every resume section (header, summary,
  // experience, skills, languages, education, additionalSections) -- see
  // ResumeSections in extract-resume-sections.ts for the exact shape.
  // Auto-regenerated (overwritten, not merged) on every upload by a
  // best-effort AI call; never hand-edited. Null until the AI call succeeds
  // at least once, or if the user has no API key configured.
  basicInfo Json?

  uploadedAt       DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

// ---------- Wizard draft (§5.5, guided-add) ----------

// One in-progress guided-add session per user -- starting a new wizard while
// a draft exists just overwrites it (no product need for multiple concurrent
// drafts). Saved at each step-transition "commit point" so a refresh doesn't
// discard already-generated (and already-paid-for) AI content; deleted once
// the wizard actually saves an Application, or the user starts over.
model WizardDraft {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  step       String // one of the wizard's STEP_KEYS
  postingUrl String?
  extracted  Json? // ExtractedPosting | null
  extras     Json? // GenerationExtras | null

  // Mirrors WizardShell's GeneratedState (incl. the posting-signature
  // "...For" fields from the stale-content-invalidation fix) so a resumed
  // draft keeps treating fit/materials generated against an since-edited
  // posting as stale, exactly like an in-memory session would.
  fit            Json?
  fitFor         String?
  cv             Json?
  cvFor          String?
  coverLetter    Json?
  coverLetterFor String?

  updatedAt DateTime @updatedAt
}
